#!/usr/bin/env bash
# Galdr one-line installer.
#   curl -fsS https://term.noxcaw.com/install | bash
#   curl -fsS https://term.noxcaw.com/install | bash -s -- v0.2.1
# Windows PowerShell: irm https://term.noxcaw.com/install.txt | iex
# Env: GALDR_TAG  GALDR_GITHUB  PREFIX  BIN_DIR  GH_TOKEN  GALDR_GITHUB_TOKEN  NO_COLOR
#      GALDR_NO_CONTEXT_MENU  GALDR_NO_START_MENU
# Does not edit .bashrc / .zshrc. Writes ~/.galdr/env for you to source if needed.
set -euo pipefail

REPO="${GALDR_GITHUB:-noxrick91/galdr-hub}"
PREFIX="${PREFIX:-${HOME}/.galdr}"
BIN_DIR="${BIN_DIR:-${PREFIX}/bin}"
TAG="${GALDR_TAG:-latest}"

if [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ]; then
  C0="" C1="" C2="" C3="" CD=""
else
  C0=$'\033[0m'
  C1=$'\033[1m'
  C2=$'\033[32m'
  C3=$'\033[31m'
  CD=$'\033[2m'
fi

step() { printf '%s▸%s %s\n' "$CD" "$C0" "$1"; }
ok() { printf '%s✓%s %s\n' "$C2" "$C0" "$1"; }
die() { printf '%s✗%s %s\n' "$C3" "$C0" "$1" >&2; exit 1; }

validate_install_paths() {
  case "${PREFIX}${BIN_DIR}" in
    *$'\n'*) die "PREFIX and BIN_DIR must not contain newlines" ;;
  esac
  mkdir -p "${PREFIX}" "${BIN_DIR}"
  local prefix_real bin_real home_real
  prefix_real="$(CDPATH= cd -P "${PREFIX}" && pwd)" \
    || die "cannot resolve PREFIX ${PREFIX}"
  bin_real="$(CDPATH= cd -P "${BIN_DIR}" && pwd)" \
    || die "cannot resolve BIN_DIR ${BIN_DIR}"
  home_real="$(CDPATH= cd -P "${HOME}" && pwd)" \
    || die "cannot resolve HOME ${HOME}"
  case "${prefix_real}" in
    / | "${home_real}")
      die "unsafe PREFIX ${prefix_real}; use a dedicated install directory"
      ;;
  esac
  case "${bin_real}" in
    "${prefix_real}" | "${prefix_real}"/*) ;;
    *) die "BIN_DIR must be inside PREFIX so uninstall remains safe" ;;
  esac
  PREFIX="${prefix_real}"
  BIN_DIR="${bin_real}"
}

desktop_exec() {
  case "$1" in
    *[[:space:]]*) printf '"%s"' "$1" ;;
    *) printf '%s' "$1" ;;
  esac
}

here_menu_title() {
  printf '%s' "Open Galdr here"
}

xml_escape() {
  printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

refresh_desktop_db() {
  local apps="${HOME}/.local/share/applications"
  if command -v xdg-desktop-menu >/dev/null 2>&1 && [ -f "${apps}/galdr.desktop" ]; then
    xdg-desktop-menu install --novendor "${apps}/galdr.desktop" >/dev/null 2>&1 || true
  fi
  if command -v update-desktop-database >/dev/null 2>&1 && [ -d "${apps}" ]; then
    update-desktop-database "${apps}" >/dev/null 2>&1 || true
  fi
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f -t "${HOME}/.local/share/icons/hicolor" >/dev/null 2>&1 || true
  fi
}

write_icon() {
  local icon="${PREFIX}/galdr.svg"
  mkdir -p "${PREFIX}"
  cat >"${icon}" <<'EOF'
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <title>Galdr</title>
  <rect width="64" height="64" rx="12" fill="#fff"/>
  <path d="M6 32h8l6-14v28l9-36v44l9-28v12l8-12v12h12" fill="none" stroke="#171816" stroke-width="6" stroke-linecap="square" stroke-linejoin="miter"/>
  <rect x="49" y="28" width="10" height="10" fill="#e64024"/>
</svg>
EOF
  local hicolor="${HOME}/.local/share/icons/hicolor/scalable/apps"
  mkdir -p "${hicolor}"
  cp -f "${icon}" "${hicolor}/galdr-pixel.svg"
  rm -f "${hicolor}/galdr.svg" "${hicolor}/galdr-wordmark.svg"

  local png="${PREFIX}/galdr.png"
  if printf '%s' '' | base64 -d >"${png}" 2>/dev/null; then
    local hicolor256="${HOME}/.local/share/icons/hicolor/256x256/apps"
    mkdir -p "${hicolor256}"
    cp -f "${png}" "${hicolor256}/galdr-pixel.png"
    rm -f "${HOME}/.local/share/icons/hicolor/64x64/apps/galdr.png" \
      "${HOME}/.local/share/icons/hicolor/64x64/apps/galdr-pixel.png" \
      "${hicolor256}/galdr-wordmark.png"
  else
    rm -f "${png}"
  fi
}

write_here_helper() {
  local helper="${PREFIX}/galdr-here"
  mkdir -p "${PREFIX}"
  printf '%s\n' '#!/usr/bin/env bash' >"${helper}"
  printf 'bin=%q\n' "${dest}" >>"${helper}"
  cat >>"${helper}" <<'EOF'
first_line() {
  printf '%s' "$1" | tr -d '\r' | sed -n '1p'
}

percent_decode() {
  in=$1
  if command -v python3 >/dev/null 2>&1; then
    decoded=$(python3 -c 'import sys, urllib.parse as u
p = sys.argv[1]
if p.startswith("file://"):
    parsed = u.urlparse(p)
    p = parsed.path
    if parsed.netloc and parsed.netloc not in ("", "localhost"):
        p = "//" + parsed.netloc + p
print(u.unquote(p))' "${in}" 2>/dev/null) && {
      printf '%s' "${decoded}"
      return
    }
  fi
  case "${in}" in
    file://localhost/*) in=${in#file://localhost} ;;
    file:///*) in=${in#file://} ;;
    file://*) in=${in#file://} ;;
  esac
  out=
  while [ -n "${in}" ]; do
    rest=${in#?}
    ch=${in%"${rest}"}
    if [ "${ch}" = "%" ]; then
      hex=${rest}
      hex=${hex%${hex#??}}
      case "${hex}" in
        [0-9A-Fa-f][0-9A-Fa-f])
          out=${out}$(printf '%b' "\\x${hex}")
          in=${rest#??}
          continue
          ;;
      esac
    fi
    out=${out}${ch}
    in=${rest}
  done
  printf '%s' "${out}"
}

path=$1
if [ -z "${path}" ]; then
  path=$(first_line "${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-}")
fi
if [ -z "${path}" ]; then
  path=${NAUTILUS_SCRIPT_CURRENT_URI:-}
fi
if [ -z "${path}" ]; then
  path=$(first_line "${CAJA_SCRIPT_SELECTED_FILE_PATHS:-}")
fi
if [ -z "${path}" ]; then
  path=${CAJA_SCRIPT_CURRENT_URI:-}
fi
if [ -z "${path}" ]; then
  path=$(first_line "${NEMO_SCRIPT_SELECTED_FILE_PATHS:-}")
fi
if [ -z "${path}" ]; then
  path=${NEMO_SCRIPT_CURRENT_URI:-}
fi
if [ -z "${path}" ]; then
  path=${PWD}
fi
path=$(percent_decode "${path}")
if [ -f "${path}" ]; then
  path=$(dirname "${path}")
fi
if [ ! -d "${path}" ]; then
  path=${PWD}
fi
exec "${bin}" --cwd "${path}"
EOF
  chmod +x "${helper}"
}

nautilus_gi_ok() {
  command -v python3 >/dev/null 2>&1 || return 1
  python3 - <<'PY' >/dev/null 2>&1
import gi
for version in ("4.1", "4.0", "3.0"):
    try:
        gi.require_version("Nautilus", version)
        break
    except ValueError:
        continue
else:
    raise SystemExit(1)
from gi.repository import Nautilus
PY
}

nautilus_python_hint() {
  if command -v apt-get >/dev/null 2>&1; then
    printf '%s' "sudo apt install python3-nautilus && nautilus -q"
  elif command -v dnf >/dev/null 2>&1; then
    printf '%s' "sudo dnf install nautilus-python && nautilus -q"
  elif command -v pacman >/dev/null 2>&1; then
    printf '%s' "sudo pacman -S nautilus-python && nautilus -q"
  else
    printf '%s' "install nautilus-python / python3-nautilus, then nautilus -q"
  fi
}

run_privileged() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  elif sudo -n true >/dev/null 2>&1; then
    sudo -n "$@"
  elif command -v pkexec >/dev/null 2>&1 && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    pkexec "$@"
  elif [ -t 0 ] && [ -t 1 ]; then
    sudo "$@"
  else
    return 1
  fi
}

install_nautilus_python_pkg() {
  if command -v apt-get >/dev/null 2>&1; then
    run_privileged apt-get install -y python3-nautilus
  elif command -v dnf >/dev/null 2>&1; then
    run_privileged dnf install -y nautilus-python
  elif command -v pacman >/dev/null 2>&1; then
    run_privileged pacman -S --noconfirm nautilus-python
  else
    return 1
  fi
}

ensure_nautilus_python() {
  [ -n "${GALDR_NO_CONTEXT_MENU:-}" ] && return 0
  command -v nautilus >/dev/null 2>&1 || return 0
  if nautilus_gi_ok; then
    ok "GNOME Files Python bindings"
    return 0
  fi
  step "Installing GNOME Files bindings so “$(here_menu_title)” is a top-level item…"
  if install_nautilus_python_pkg && nautilus_gi_ok; then
    ok "GNOME Files Python bindings"
    return 0
  fi
  printf '  hint: GNOME Files hides the item without Python bindings.\n'
  printf '        %s\n' "$(nautilus_python_hint)"
}

reload_nautilus() {
  command -v nautilus >/dev/null 2>&1 || return 0
  nautilus -q >/dev/null 2>&1 || true
}

write_desktop_entry() {
  [ -n "${GALDR_NO_START_MENU:-}" ] && return 0
  local apps="${HOME}/.local/share/applications"
  mkdir -p "${apps}"
  local exec
  exec="$(desktop_exec "${dest}")"
  cat >"${apps}/galdr.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Galdr
Comment=GPU-accelerated terminal
Comment[zh_CN]=GPU 加速终端
Comment[zh_TW]=GPU 加速終端
Exec=${exec}
TryExec=${dest}
Icon=galdr-pixel
Terminal=false
Categories=System;TerminalEmulator;
Keywords=terminal;shell;console;
Keywords[zh_CN]=终端;命令行;控制台;
StartupNotify=true
StartupWMClass=galdr
X-TerminalArgExec=-e
X-TerminalArgDir=--cwd
EOF
  refresh_desktop_db
  ok "App menu: ${apps}/galdr.desktop"
}

write_nautilus_extension() {
  [ -n "${GALDR_NO_CONTEXT_MENU:-}" ] && return 0
  local dir="${HOME}/.local/share/nautilus-python/extensions"
  mkdir -p "${dir}"
  local helper="${PREFIX}/galdr-here"
  local title
  title="$(here_menu_title)"
  {
    printf '%s\n' "# Generated by the Galdr installer."
    printf 'HELPER = %s\n' "$(python3 -c 'import sys; print(repr(sys.argv[1]))' "${helper}" 2>/dev/null || printf "'%s'" "${helper}")"
    printf 'LABEL = %s\n' "$(python3 -c 'import sys; print(repr(sys.argv[1]))' "${title}" 2>/dev/null || printf "'%s'" "${title}")"
    cat <<'EOF'
import os
import subprocess

import gi

_NAUTILUS = None
for _ver in ("4.1", "4.0", "3.0"):
    try:
        gi.require_version("Nautilus", _ver)
        _NAUTILUS = _ver
        break
    except ValueError:
        continue
if _NAUTILUS is None:
    raise ImportError("Nautilus GI typelib is not installed")

from gi.repository import GObject, Nautilus


def _path(info):
    loc = info.get_location() if hasattr(info, "get_location") else None
    if loc is not None:
        path = loc.get_path()
        if path:
            return path
    uri = info.get_uri() if hasattr(info, "get_uri") else None
    if not uri:
        return None
    try:
        from gi.repository import GLib

        path, _host = GLib.filename_from_uri(uri)
        return path
    except Exception:
        pass
    if uri.startswith("file://"):
        return uri[7:]
    return None


class GaldrHere(GObject.GObject, Nautilus.MenuProvider):
    __gtype_name__ = "GaldrHere"

    def _items(self, path):
        if not path:
            return []
        if os.path.isfile(path):
            path = os.path.dirname(path)
        if not os.path.isdir(path):
            return []
        item = Nautilus.MenuItem(name="GaldrHere::Open", label=LABEL, icon="galdr-pixel")
        item.connect("activate", self._open, path)
        return [item]

    def _open(self, _item, path):
        subprocess.Popen([HELPER, path], start_new_session=True)

    def get_file_items(self, *args):
        files = args[-1]
        if not files:
            return []
        paths = [p for p in (_path(f) for f in files) if p]
        if not paths:
            return []
        dirs = {
            os.path.dirname(p) if os.path.isfile(p) else p
            for p in paths
        }
        if len(dirs) != 1:
            return []
        return self._items(dirs.pop())

    def get_background_items(self, *args):
        return self._items(_path(args[-1]))
EOF
  } >"${dir}/galdr-here.py"
}

install_file_manager_actions() {
  [ -n "${GALDR_NO_CONTEXT_MENU:-}" ] && return 0
  local helper="${PREFIX}/galdr-here"
  local name
  name="$(here_menu_title)"
  local old_name
  for old_name in "Open Galdr here" "在此处打开 Galdr" "在此處開啟 Galdr"; do
    rm -f "${HOME}/.local/share/nautilus/scripts/${old_name}" \
      "${HOME}/.config/caja/scripts/${old_name}"
  done

  local script
  for script in \
    "${HOME}/.local/share/nautilus/scripts/${name}" \
    "${HOME}/.config/caja/scripts/${name}"
  do
    mkdir -p "$(dirname "${script}")"
    cat >"${script}" <<EOF
#!/bin/sh
exec "${helper}" "\$@"
EOF
    chmod +x "${script}"
  done

  local nemo="${HOME}/.local/share/nemo/actions"
  mkdir -p "${nemo}"
  cat >"${nemo}/galdr-dir.nemo_action" <<EOF
[Nemo Action]
Name=Open Galdr here
Comment=Open Galdr in this folder
Exec="${helper}" %F
Icon-Name=galdr-pixel
Selection=s
Extensions=dir;
Quote=double
EOF
  cat >"${nemo}/galdr-bg.nemo_action" <<EOF
[Nemo Action]
Name=Open Galdr here
Comment=Open Galdr in this folder
Exec="${helper}" %P
Icon-Name=galdr-pixel
Selection=none
Extensions=any;
Quote=double
EOF

  local kde_body
  kde_body=$(cat <<EOF
[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=inode/directory;
Actions=openGaldr;
X-KDE-Priority=TopLevel

[Desktop Action openGaldr]
Name=Open Galdr here
Icon=galdr-pixel
Exec="${helper}" %f
EOF
)
  local kde
  for kde in \
    "${HOME}/.local/share/kio/servicemenus" \
    "${HOME}/.local/share/kservices5/ServiceMenus"
  do
    mkdir -p "${kde}"
    printf '%s\n' "${kde_body}" >"${kde}/galdr.desktop"
    chmod +x "${kde}/galdr.desktop" 2>/dev/null || true
  done

  local fm_actions="${HOME}/.local/share/file-manager/actions"
  mkdir -p "${fm_actions}"
  cat >"${fm_actions}/galdr-here.desktop" <<EOF
[Desktop Entry]
Type=Action
Name=Open Galdr here
Icon=galdr-pixel
Profiles=folder;

[X-Action-Profile folder]
Name=Open Galdr here
MimeTypes=inode/directory;
Exec="${helper}" %f
EOF

  local contractor="${HOME}/.local/share/contractor"
  mkdir -p "${contractor}"
  cat >"${contractor}/galdr-here.contract" <<EOF
[Contractor Entry]
Name=Open Galdr here
Icon=galdr-pixel
Description=Open Galdr in this folder
MimeType=inode;
Exec="${helper}" %U
EOF

  local uca="${HOME}/.config/Thunar/uca.xml"
  local uca_name
  uca_name="$(xml_escape "${name}")"
  mkdir -p "$(dirname "${uca}")"
  if [ -f "${uca}" ] && grep -q 'galdr-open-here' "${uca}"; then
    local tmp_uca
    tmp_uca="$(mktemp)"
    awk -v cmd="${helper} %f" -v n="${uca_name}" '
      /<unique-id>galdr-open-here<\/unique-id>/ { hit=1 }
      hit && /<name>/ { sub(/<name>.*<\/name>/, "<name>" n "</name>") }
      hit && /<command>/ { sub(/<command>.*<\/command>/, "<command>" cmd "</command>"); hit=0 }
      { print }
    ' "${uca}" >"${tmp_uca}"
    mv "${tmp_uca}" "${uca}"
  elif [ ! -f "${uca}" ]; then
    cat >"${uca}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
	<icon>galdr-pixel</icon>
	<name>${uca_name}</name>
	<unique-id>galdr-open-here</unique-id>
	<command>${helper} %f</command>
	<description>Open Galdr in this folder</description>
	<patterns>*</patterns>
	<directories/>
</action>
</actions>
EOF
  else
    local tmp_uca
    tmp_uca="$(mktemp)"
    awk -v cmd="${helper} %f" -v n="${uca_name}" '
      /<\/actions>/ && !done {
        print "<action>"
        print "\t<icon>galdr-pixel</icon>"
        print "\t<name>" n "</name>"
        print "\t<unique-id>galdr-open-here</unique-id>"
        print "\t<command>" cmd "</command>"
        print "\t<description>Open Galdr in this folder</description>"
        print "\t<patterns>*</patterns>"
        print "\t<directories/>"
        print "</action>"
        done=1
      }
      { print }
    ' "${uca}" >"${tmp_uca}"
    mv "${tmp_uca}" "${uca}"
  fi
  ok "Folder context menu: ${name}"
}

write_uninstall() {
  local uninst="${PREFIX}/uninstall"
  local bin_rel
  if [ "${BIN_DIR}" = "${PREFIX}" ]; then
    bin_rel="."
  else
    bin_rel="${BIN_DIR#"${PREFIX}/"}"
  fi
  {
    printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail'
    printf 'EXPECTED_PREFIX=%q\n' "${PREFIX}"
    printf 'BIN_REL=%q\n' "${bin_rel}"
    cat <<'EOF'
PREFIX=$(CDPATH= cd -P "$(dirname "$0")" && pwd) || exit 1
if [ "${PREFIX}" != "${EXPECTED_PREFIX}" ]; then
  printf 'Refusing to uninstall from unexpected path: %s\n' "${PREFIX}" >&2
  exit 1
fi
if [ "$(cat "${PREFIX}/.galdr-install-root" 2>/dev/null || true)" != "galdr-install-v1" ]; then
  printf 'Refusing to remove an unmarked install root: %s\n' "${PREFIX}" >&2
  exit 1
fi
BIN_DIR="${PREFIX}/${BIN_REL}"
rm -f \
  "${BIN_DIR}/galdr" "${BIN_DIR}/galdr.bak" \
  "${BIN_DIR}/galdr-sh" "${BIN_DIR}/galdr-sh.bak" \
  "${BIN_DIR}/galdr.exe" "${BIN_DIR}/galdr.exe.bak" \
  "${BIN_DIR}/galdr-sh.exe" "${BIN_DIR}/galdr-sh.exe.bak" \
  "${BIN_DIR}/galdr-plugin-host" "${BIN_DIR}/galdr-plugin-host.bak" \
  "${BIN_DIR}/galdr-plugin-host.exe" "${BIN_DIR}/galdr-plugin-host.exe.bak" \
  "${BIN_DIR}/galdr-plugin" "${BIN_DIR}/galdr-plugin.bak" \
  "${BIN_DIR}/galdr-plugin.exe" "${BIN_DIR}/galdr-plugin.exe.bak" \
  "${HOME}/.local/share/applications/galdr.desktop" \
  "${HOME}/.local/share/icons/hicolor/scalable/apps/galdr.svg" \
  "${HOME}/.local/share/icons/hicolor/scalable/apps/galdr-pixel.svg" \
  "${HOME}/.local/share/icons/hicolor/scalable/apps/galdr-wordmark.svg" \
  "${HOME}/.local/share/icons/hicolor/64x64/apps/galdr.png" \
  "${HOME}/.local/share/icons/hicolor/64x64/apps/galdr-pixel.png" \
  "${HOME}/.local/share/icons/hicolor/256x256/apps/galdr-pixel.png" \
  "${HOME}/.local/share/icons/hicolor/256x256/apps/galdr-wordmark.png" \
  "${HOME}/.local/share/nautilus-python/extensions/galdr-here.py" \
  "${HOME}/.local/share/nemo/actions/galdr-dir.nemo_action" \
  "${HOME}/.local/share/nemo/actions/galdr-bg.nemo_action" \
  "${HOME}/.local/share/kio/servicemenus/galdr.desktop" \
  "${HOME}/.local/share/kservices5/ServiceMenus/galdr.desktop" \
  "${HOME}/.local/share/file-manager/actions/galdr-here.desktop" \
  "${HOME}/.local/share/contractor/galdr-here.contract"
for title in "Open Galdr here" "在此处打开 Galdr" "在此處開啟 Galdr"; do
  rm -f "${HOME}/.local/share/nautilus/scripts/${title}" \
    "${HOME}/.config/caja/scripts/${title}"
done
if command -v xdg-desktop-menu >/dev/null 2>&1; then
  xdg-desktop-menu uninstall --novendor galdr.desktop >/dev/null 2>&1 || true
fi
if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database "${HOME}/.local/share/applications" >/dev/null 2>&1 || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
  gtk-update-icon-cache -f -t "${HOME}/.local/share/icons/hicolor" >/dev/null 2>&1 || true
fi
remove_thunar() {
  uca="${HOME}/.config/Thunar/uca.xml"
  [ -f "${uca}" ] || return 0
  grep -q 'galdr-open-here' "${uca}" || return 0
  tmp=$(mktemp)
  awk '
    /<action>/ { buf=$0 ORS; grab=1; next }
    grab {
      buf=buf $0 ORS
      if ($0 ~ /<\/action>/) {
        if (buf !~ /galdr-open-here/) printf "%s", buf
        grab=0
        buf=""
      }
      next
    }
    { print }
  ' "${uca}" >"${tmp}"
  mv "${tmp}" "${uca}"
}
remove_thunar
rm -f \
  "${PREFIX}/env" "${PREFIX}/galdr-here" \
  "${PREFIX}/galdr.svg" "${PREFIX}/galdr.png" \
  "${PREFIX}/.galdr-install-root" "${PREFIX}/uninstall"
if [ "${BIN_DIR}" != "${PREFIX}/." ]; then
  rmdir "${BIN_DIR}" 2>/dev/null || true
fi
if rmdir "${PREFIX}" 2>/dev/null; then
  printf 'Removed %s\n' "${PREFIX}"
else
  printf 'Removed Galdr files; kept non-Galdr files in %s\n' "${PREFIX}"
fi
printf 'Config in ~/.config/galdr/ was left in place.\n'
EOF
  } >"${uninst}"
  chmod +x "${uninst}"
}

write_install_marker() {
  printf '%s\n' galdr-install-v1 > "${PREFIX}/.galdr-install-root"
}

write_env_file() {
  local env_file="${PREFIX}/env"
  local quoted_bin_dir
  quoted_bin_dir="${BIN_DIR//\'/\'\\\'\'}"
  mkdir -p "${PREFIX}"
  cat >"${env_file}" <<EOF
# Generated by the Galdr installer. Source this file; it is not hooked into rc files.
case ":\${PATH}:" in
  *":${quoted_bin_dir}:"*) ;;
  *) export PATH='${quoted_bin_dir}':"\${PATH}" ;;
esac
EOF
  set +eu
  # shellcheck disable=SC1090
  . "${env_file}"
  set -eu
  case ":${PATH}:" in
    *":${BIN_DIR}:"*) ;;
    *) export PATH="${BIN_DIR}:${PATH}" ;;
  esac
}

if [ $# -gt 1 ]; then
  die "Usage: install [latest|now|vX.Y.Z]"
fi
if [ $# -eq 1 ]; then
  TAG="$1"
fi
case "${TAG}" in
  latest | now) TAG="latest" ;;
  v*) ;;
  [0-9]*) TAG="v${TAG}" ;;
  *) die "invalid version \`${TAG}\` (want latest|now|vX.Y.Z)" ;;
esac

command -v curl >/dev/null 2>&1 || die "missing curl"
command -v uname >/dev/null 2>&1 || die "missing uname"

printf '\n%s Galdr installer%s\n\n' "$C1" "$C0"

step "Detecting platform…"
os="$(uname -s | tr '[:upper:]' '[:lower:]')"
arch="$(uname -m)"
bin_name="galdr"
fallback_asset=""
platform=""
case "${os}-${arch}" in
  linux-x86_64 | linux-amd64)
    asset="galdr-x86_64-unknown-linux-gnu"
    platform="linux"
    ;;
  linux-aarch64 | linux-arm64)
    asset="galdr-aarch64-unknown-linux-gnu"
    platform="linux"
    ;;
  darwin-*)
    die "macOS prebuilt packages are temporarily unavailable"
    ;;
  mingw*-aarch64 | mingw*-arm64 | msys*-aarch64 | msys*-arm64 | cygwin*-aarch64 | cygwin*-arm64 | windows*-aarch64 | windows*-arm64)
    asset="galdr-aarch64-pc-windows-msvc.exe"
    fallback_asset="galdr-x86_64-pc-windows-gnu.exe"
    bin_name="galdr.exe"
    platform="windows"
    ;;
  mingw* | msys* | cygwin* | windows*)
    asset="galdr-x86_64-pc-windows-gnu.exe"
    bin_name="galdr.exe"
    platform="windows"
    ;;
  *)
    die "unsupported platform ${os}-${arch}. See https://github.com/${REPO}/releases"
    ;;
esac
ok "Detected ${os}/${arch} → ${asset}"

validate_install_paths
dest="${BIN_DIR}/${bin_name}"
shell_dest=""
shell_asset=""
plugin_host_dest="${BIN_DIR}/galdr-plugin-host"
plugin_cli_dest="${BIN_DIR}/galdr-plugin"
if [ "${platform}" = "linux" ]; then
  shell_dest="${BIN_DIR}/galdr-sh"
elif [ "${platform}" = "windows" ]; then
  shell_dest="${BIN_DIR}/galdr-sh.exe"
  plugin_host_dest="${plugin_host_dest}.exe"
  plugin_cli_dest="${plugin_cli_dest}.exe"
fi
galdr_path_before_install="$(command -v galdr 2>/dev/null || true)"

process_uses_managed_path() {
  local pid="$1" proc="/proc/$1" target exe target_real
  exe="$(readlink -f "${proc}/exe" 2>/dev/null || true)"
  for target in "${dest}" "${shell_dest}" "${plugin_host_dest}" "${plugin_cli_dest}"; do
    [ -n "${target}" ] || continue
    target_real="$(readlink -f "${target}" 2>/dev/null || true)"
    if [ -n "${exe}" ] && [ -n "${target_real}" ] && [ "${exe}" = "${target_real}" ]; then
      return 0
    fi
    if [ -r "${proc}/cmdline" ] \
      && tr '\0' '\n' <"${proc}/cmdline" | grep -Fqx -- "${target}"; then
      return 0
    fi
  done
  return 1
}

managed_install_is_running() {
  [ -d /proc ] || return 1
  local proc pid
  for proc in /proc/[0-9]*; do
    [ -d "${proc}" ] || continue
    pid="${proc##*/}"
    [ "${pid}" != "$$" ] || continue
    if process_uses_managed_path "${pid}"; then
      return 0
    fi
  done
  return 1
}

canonical_existing_path() {
  if command -v realpath >/dev/null 2>&1; then
    realpath "$1" 2>/dev/null && return
  fi
  readlink -f "$1" 2>/dev/null && return
  local directory base
  directory="$(CDPATH= cd -P "$(dirname "$1")" && pwd)" || return 1
  base="$(basename "$1")"
  printf '%s/%s\n' "${directory}" "${base}"
}

show_galdr_path_conflict() {
  local resolved resolved_real dest_real
  resolved="${galdr_path_before_install:-}"
  [ -n "${resolved}" ] && [ -e "${resolved}" ] || return 0
  resolved_real="$(canonical_existing_path "${resolved}" || true)"
  dest_real="$(canonical_existing_path "${dest}" || true)"
  if [ -n "${resolved_real}" ] && [ -n "${dest_real}" ] \
    && [ "${resolved_real}" != "${dest_real}" ]; then
    printf '  warning: PATH resolves galdr to %s\n' "${resolved}"
    printf '           installer wrote %s\n' "${dest}"
    printf '           source %s/env or remove the older PATH entry.\n' "${PREFIX}"
  fi
}

if [ "${TAG}" = "latest" ]; then
  base="https://github.com/${REPO}/releases/latest/download"
else
  base="https://github.com/${REPO}/releases/download/${TAG}"
fi

auth=()
token="${GALDR_GITHUB_TOKEN:-${GH_TOKEN:-}}"
if [ -n "${token}" ]; then
  auth=(-H "Authorization: Bearer ${token}")
fi

download() {
  local url="$1" out="$2" label="$3"
  step "${label}"
  local code status=0
  code="$(curl --proto '=https' --proto-redir '=https' --tlsv1.2 \
    -fL --progress-bar --connect-timeout 20 --max-time 600 \
    --retry 2 --retry-delay 2 --retry-all-errors \
    -A "galdr-installer" "${auth[@]}" -o "${out}" \
    -w "%{http_code}" "${url}")" || status=$?
  if [ "${code}" = "404" ]; then
    die "not found: ${url}
  no public Release yet — https://github.com/${REPO}/releases"
  fi
  if [ "${code}" = "403" ] || [ "${code}" = "429" ]; then
    die "GitHub HTTP ${code}. Set GH_TOKEN or GALDR_GITHUB_TOKEN and retry."
  fi
  if [ "${status}" -ne 0 ] || [ "${code}" != "200" ]; then
    rm -f "${out}"
    die "download failed (curl ${status}, HTTP ${code:-000}) for ${url}"
  fi
}

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    die "missing sha256sum/shasum"
  fi
}

tmp="$(mktemp -d)"
cleanup() { rm -rf "${tmp}"; }
trap cleanup EXIT

download "${base}/SHA256SUMS" "${tmp}/SHA256SUMS" "Fetching SHA256SUMS…"
tr -d '\r' <"${tmp}/SHA256SUMS" >"${tmp}/SHA256SUMS.lf"
mv "${tmp}/SHA256SUMS.lf" "${tmp}/SHA256SUMS"

sum_for() {
  awk -v a="$1" '$NF==a || $NF=="*"a {print $1; exit}' "${tmp}/SHA256SUMS"
}

fetch_candidate() {
  local candidate="$1"
  expect="$(sum_for "${candidate}")"
  [ -n "${expect}" ] || return 1
  asset="${candidate}"
  download "${base}/${asset}" "${tmp}/${asset}" "Downloading ${asset}…"
  got="$(sha256_of "${tmp}/${asset}")"
  if [ "${expect}" != "${got}" ]; then
    die "SHA256 mismatch for ${asset}
  expected ${expect}
  got      ${got}"
  fi
  plugin_host_asset="${asset/galdr-/galdr-plugin-host-}"
  plugin_cli_asset="${asset/galdr-/galdr-plugin-}"
  for companion_asset in "${plugin_host_asset}" "${plugin_cli_asset}"; do
    companion_expect="$(sum_for "${companion_asset}")"
    [ -n "${companion_expect}" ] \
      || die "SHA256SUMS has no entry for required plugin binary ${companion_asset}"
    download "${base}/${companion_asset}" "${tmp}/${companion_asset}" \
      "Downloading ${companion_asset}…"
    companion_got="$(sha256_of "${tmp}/${companion_asset}")"
    if [ "${companion_expect}" != "${companion_got}" ]; then
      die "SHA256 mismatch for ${companion_asset}
  expected ${companion_expect}
  got      ${companion_got}"
    fi
  done
  shell_asset="${asset/galdr-/galdr-sh-}"
  shell_expect="$(sum_for "${shell_asset}")"
  [ -n "${shell_expect}" ] \
    || die "SHA256SUMS has no entry for required shell helper ${shell_asset}"
  download "${base}/${shell_asset}" "${tmp}/${shell_asset}" \
    "Downloading ${shell_asset}…"
  shell_got="$(sha256_of "${tmp}/${shell_asset}")"
  if [ "${shell_expect}" != "${shell_got}" ]; then
    die "SHA256 mismatch for ${shell_asset}
  expected ${shell_expect}
  got      ${shell_got}"
  fi
}

if ! fetch_candidate "${asset}"; then
  if [ -z "${fallback_asset}" ]; then
    die "SHA256SUMS has no entry for ${asset}"
  fi
  step "No ${asset} in this release — using ${fallback_asset}"
  fetch_candidate "${fallback_asset}" \
    || die "SHA256SUMS has no entry for ${fallback_asset}"
fi
chmod +x "${tmp}/${asset}"
chmod +x "${tmp}/${plugin_host_asset}" "${tmp}/${plugin_cli_asset}"
if [ -n "${shell_asset}" ]; then
  chmod +x "${tmp}/${shell_asset}"
fi
candidate_error=""
if ! candidate_error="$("${tmp}/${asset}" --help 2>&1)"; then
  if [ -n "${fallback_asset}" ] && [ "${asset}" != "${fallback_asset}" ]; then
    step "${asset} cannot run here — trying ${fallback_asset} through Windows emulation"
    fetch_candidate "${fallback_asset}" \
      || die "SHA256SUMS has no entry for ${fallback_asset}"
    chmod +x "${tmp}/${asset}" "${tmp}/${shell_asset}" \
      "${tmp}/${plugin_host_asset}" "${tmp}/${plugin_cli_asset}"
    if ! candidate_error="$("${tmp}/${asset}" --help 2>&1)"; then
      die "neither native nor emulated Windows build runs: ${candidate_error:-unknown error}"
    fi
  else
    runtime_hint=""
    if [ "${platform}" = "linux" ]; then
      runtime_hint=" (the release requires glibc 2.35 or newer)"
    fi
    die "downloaded binary did not run${runtime_hint}: ${candidate_error:-unknown error}"
  fi
fi
candidate_ver="$("${tmp}/${asset}" --version 2>/dev/null || true)"
candidate_shell_ver="$("${tmp}/${shell_asset}" --version 2>/dev/null || true)"
candidate_host_ver="$("${tmp}/${plugin_host_asset}" --version 2>/dev/null || true)"
candidate_plugin_ver="$("${tmp}/${plugin_cli_asset}" --version 2>/dev/null || true)"
case "${candidate_ver}" in
  "galdr "*) candidate_ver_num="${candidate_ver##* }" ;;
  *) die "${asset} returned an invalid version: ${candidate_ver:-unavailable}" ;;
esac
candidate_ver_num="${candidate_ver_num#v}"
case "${candidate_shell_ver}" in
  "galdr-sh "*) candidate_shell_ver_num="${candidate_shell_ver##* }" ;;
  *) die "${shell_asset} returned an invalid version: ${candidate_shell_ver:-unavailable}" ;;
esac
case "${candidate_host_ver}" in
  "galdr-plugin-host "*) candidate_host_ver_num="${candidate_host_ver##* }" ;;
  *) die "${plugin_host_asset} returned an invalid version: ${candidate_host_ver:-unavailable}" ;;
esac
case "${candidate_plugin_ver}" in
  "galdr-plugin "*) candidate_plugin_ver_num="${candidate_plugin_ver##* }" ;;
  *) die "${plugin_cli_asset} returned an invalid version: ${candidate_plugin_ver:-unavailable}" ;;
esac
candidate_shell_ver_num="${candidate_shell_ver_num#v}"
candidate_host_ver_num="${candidate_host_ver_num#v}"
candidate_plugin_ver_num="${candidate_plugin_ver_num#v}"
if [ "${candidate_shell_ver_num}" != "${candidate_ver_num}" ] \
  || [ "${candidate_host_ver_num}" != "${candidate_ver_num}" ] \
  || [ "${candidate_plugin_ver_num}" != "${candidate_ver_num}" ]; then
  die "runtime binary versions do not match ${asset} ${candidate_ver_num}"
fi
ok "Checksums and executable verified"

[ ! -d "${dest}" ] || die "install target is a directory: ${dest}"
[ ! -d "${plugin_host_dest}" ] || die "install target is a directory: ${plugin_host_dest}"
[ ! -d "${plugin_cli_dest}" ] || die "install target is a directory: ${plugin_cli_dest}"
running_install=0
if managed_install_is_running; then
  running_install=1
  step "Updating the installed files without stopping the current Galdr session"
fi
previous_dir="${tmp}/previous"
mkdir -p "${previous_dir}"
for managed in \
  "${BIN_DIR}/galdr" "${BIN_DIR}/galdr.exe" \
  "${BIN_DIR}/galdr-sh" "${BIN_DIR}/galdr-sh.exe" \
  "${BIN_DIR}/galdr-plugin-host" "${BIN_DIR}/galdr-plugin-host.exe" \
  "${BIN_DIR}/galdr-plugin" "${BIN_DIR}/galdr-plugin.exe"
do
  rm -f "${managed}.bak"
  case "${managed}" in
    "${dest}" | "${shell_dest}" | "${plugin_host_dest}" | "${plugin_cli_dest}") ;;
    *) rm -f "${managed}" ;;
  esac
done
rm -rf "${PREFIX}/updates" "${PREFIX}/backup"

had_dest=0
if [ -e "${dest}" ] || [ -L "${dest}" ]; then
  had_dest=1
  mv -f "${dest}" "${previous_dir}/main" || die "could not stage ${dest} for replacement"
fi
if ! mv "${tmp}/${asset}" "${dest}"; then
  if [ "${had_dest}" = "1" ] && [ -e "${previous_dir}/main" ]; then
    mv -f "${previous_dir}/main" "${dest}"
  fi
  die "could not install ${dest}"
fi
ok "Installed ${dest}"

had_shell_dest=0
rollback_shell_wrapper() {
  [ -n "${shell_dest}" ] || return 0
  rm -f "${shell_dest}"
  if [ "${had_shell_dest}" = "1" ] && [ -e "${previous_dir}/shell" ]; then
    mv -f "${previous_dir}/shell" "${shell_dest}"
  fi
}

rollback_binary() {
  rm -f "${dest}"
  if [ "${had_dest}" = "1" ] && [ -e "${previous_dir}/main" ]; then
    mv -f "${previous_dir}/main" "${dest}"
  fi
}
had_plugin_host_dest=0
had_plugin_cli_dest=0
rollback_plugin_host() {
  rm -f "${plugin_host_dest}"
  if [ "${had_plugin_host_dest}" = "1" ] \
    && [ -e "${previous_dir}/plugin-host" ]; then
    mv -f "${previous_dir}/plugin-host" "${plugin_host_dest}"
  fi
}
rollback_plugin_cli() {
  rm -f "${plugin_cli_dest}"
  if [ "${had_plugin_cli_dest}" = "1" ] \
    && [ -e "${previous_dir}/plugin-cli" ]; then
    mv -f "${previous_dir}/plugin-cli" "${plugin_cli_dest}"
  fi
}
if ! "${dest}" --help >/dev/null 2>&1; then
  rollback_binary
  die "downloaded binary did not run: ${dest} --help"
fi
ver="$("${dest}" --version 2>/dev/null || true)"
case "${ver}" in
  "galdr "*) ;;
  *)
    rollback_binary
    die "${dest} returned an invalid version: ${ver:-unavailable}"
    ;;
esac
installed_ver_num="${ver##* }"
installed_ver_num="${installed_ver_num#v}"
if [ "${TAG}" != "latest" ]; then
  expect_ver="${TAG#v}"
  if [ "${installed_ver_num}" != "${expect_ver}" ]; then
    rollback_binary
    die "${dest} --version is \`${ver}\`, expected ${expect_ver}"
  fi
fi

if [ -n "${shell_dest}" ]; then
  if [ -d "${shell_dest}" ]; then
    rollback_binary
    die "install target is a directory: ${shell_dest}"
  fi
  if [ -e "${shell_dest}" ] || [ -L "${shell_dest}" ]; then
    had_shell_dest=1
    old_shell_ver="$("${shell_dest}" --version 2>/dev/null || true)"
    old_shell_ver_num="${old_shell_ver##* }"
    old_shell_ver_num="${old_shell_ver_num#v}"
    if [ -z "${old_shell_ver}" ] || [ "${old_shell_ver_num}" != "${installed_ver_num}" ]; then
      step "Replacing old ${old_shell_ver:-unversioned galdr-sh} at ${shell_dest}"
    fi
    if ! mv -f "${shell_dest}" "${previous_dir}/shell"; then
      rollback_binary
      die "could not stage ${shell_dest} for replacement"
    fi
  fi
  helper_source="${tmp}/${shell_asset}"
  if ! chmod +x "${helper_source}"; then
    rollback_shell_wrapper
    rollback_binary
    die "could not make galdr-sh wrapper executable"
  fi
  if ! mv "${helper_source}" "${shell_dest}"; then
    rollback_shell_wrapper
    rollback_binary
    die "could not install ${shell_dest}"
  fi
  shell_ver="$("${shell_dest}" --version 2>/dev/null || true)"
  shell_ver_num="${shell_ver##* }"
  shell_ver_num="${shell_ver_num#v}"
  if [ -z "${shell_ver}" ] || [ "${shell_ver_num}" != "${installed_ver_num}" ]; then
    rollback_shell_wrapper
    rollback_binary
    die "${shell_dest} version \`${shell_ver:-unavailable}\` does not match ${dest} \`${ver:-unavailable}\`"
  fi
  ok "Installed matching ${shell_dest}"
fi

if [ -e "${plugin_host_dest}" ] || [ -L "${plugin_host_dest}" ]; then
  had_plugin_host_dest=1
  if ! mv -f "${plugin_host_dest}" "${previous_dir}/plugin-host"; then
    rollback_shell_wrapper
    rollback_binary
    die "could not stage ${plugin_host_dest} for replacement"
  fi
fi
if ! mv "${tmp}/${plugin_host_asset}" "${plugin_host_dest}"; then
  rollback_plugin_host
  rollback_shell_wrapper
  rollback_binary
  die "could not install ${plugin_host_dest}"
fi

if [ -e "${plugin_cli_dest}" ] || [ -L "${plugin_cli_dest}" ]; then
  had_plugin_cli_dest=1
  if ! mv -f "${plugin_cli_dest}" "${previous_dir}/plugin-cli"; then
    rollback_plugin_host
    rollback_shell_wrapper
    rollback_binary
    die "could not stage ${plugin_cli_dest} for replacement"
  fi
fi
if ! mv "${tmp}/${plugin_cli_asset}" "${plugin_cli_dest}"; then
  rollback_plugin_cli
  rollback_plugin_host
  rollback_shell_wrapper
  rollback_binary
  die "could not install ${plugin_cli_dest}"
fi

host_ver="$("${plugin_host_dest}" --version 2>/dev/null || true)"
plugin_ver="$("${plugin_cli_dest}" --version 2>/dev/null || true)"
host_ver_num="${host_ver##* }"
plugin_ver_num="${plugin_ver##* }"
host_ver_num="${host_ver_num#v}"
plugin_ver_num="${plugin_ver_num#v}"
if [ "${host_ver_num}" != "${installed_ver_num}" ] \
  || [ "${plugin_ver_num}" != "${installed_ver_num}" ]; then
  rollback_plugin_cli
  rollback_plugin_host
  rollback_shell_wrapper
  rollback_binary
  die "installed plugin binary versions do not match ${dest} ${installed_ver_num}"
fi
ok "Installed matching ${plugin_host_dest}"
ok "Installed matching ${plugin_cli_dest}"

rm -f "${dest}.bak"
if [ -n "${shell_dest}" ]; then
  rm -f "${shell_dest}.bak"
fi
rm -f "${plugin_host_dest}.bak" "${plugin_cli_dest}.bak"

write_env_file
write_install_marker
write_uninstall || printf '  warning: could not write uninstall helper\n'

if [ "${os}" = "linux" ]; then
  desktop_integration=0
  context_integration=0
  if [ -z "${GALDR_NO_START_MENU:-}" ] || [ -z "${GALDR_NO_CONTEXT_MENU:-}" ]; then
    write_icon || printf '  warning: could not write desktop icon\n'
  fi
  if [ -z "${GALDR_NO_START_MENU:-}" ]; then
    if write_desktop_entry; then
      desktop_integration=1
    else
      printf '  warning: application menu integration failed\n'
    fi
  fi
  if [ -z "${GALDR_NO_CONTEXT_MENU:-}" ] \
    && write_here_helper && write_nautilus_extension && install_file_manager_actions; then
    ensure_nautilus_python || true
    reload_nautilus || true
    context_integration=1
  else
    if [ -z "${GALDR_NO_CONTEXT_MENU:-}" ]; then
      printf '  warning: folder context menu integration failed\n'
    fi
  fi
fi

printf '\n%sInstallation complete.%s\n' "$C1" "$C0"
if [ -n "${ver}" ]; then
  printf '  version  %s\n' "${ver}"
fi
printf '  binary   %s\n' "${dest}"
if [ -n "${shell_dest}" ]; then
  printf '  shell    %s\n' "${shell_dest}"
fi
printf '  host     %s\n' "${plugin_host_dest}"
printf '  plugins  %s\n' "${plugin_cli_dest}"
printf '  sha256   %s\n' "${got}"
printf '  PATH     %s\n' "${BIN_DIR}"
show_galdr_path_conflict
printf '\n  The installer does not edit .bashrc or .zshrc.\n'
printf '  source %s/env\n' "${PREFIX}"
printf '  or add %s to PATH, then open Galdr:\n' "${BIN_DIR}"
printf '\n  galdr\n  galdr --version\n'
if [ "${running_install}" = "1" ]; then
  printf '  Restart open Galdr windows and shells to use %s.\n' "${ver}"
fi
if [ "${os}" = "linux" ]; then
  if [ "${desktop_integration:-0}" = "1" ]; then
    printf '  App menu: Galdr\n'
  fi
  if [ "${context_integration:-0}" = "1" ]; then
    printf '  Right-click a folder: %s\n' "$(here_menu_title)"
  fi
  if [ "${context_integration:-0}" = "1" ] \
    && command -v nautilus >/dev/null 2>&1 && ! nautilus_gi_ok; then
    printf '  GNOME Files: %s\n' "$(nautilus_python_hint)"
  fi
fi
printf '  uninstall %s/uninstall\n' "${PREFIX}"
printf '\n'
